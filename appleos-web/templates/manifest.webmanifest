{
  "name": "AppleOS",
  "short_name": "AppleOS",
  "description": "AppleOS adaptive desktop/mobile web shell",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "fullscreen"],
  "background_color": "#080a10",
  "theme_color": "#0b0d14",
  "orientation": "any",
  "icons": [
    {
      "src": "./assets/icons/apple-logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icons/apple-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
